{
  "name": "studybot-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run --project worker --project client",
    "cf-typegen": "wrangler types --strict-vars=false src/worker/worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "deploy:staging": "CLOUDFLARE_ENV=staging vite build && CLOUDFLARE_ENV=staging wrangler d1 migrations apply DB --remote && wrangler deploy",
    "deploy:production": "CLOUDFLARE_ENV=production vite build && CLOUDFLARE_ENV=production wrangler d1 migrations apply DB --remote && wrangler deploy",
    "corpus:build": "cd .. && PYTHONPATH=src/python python3 -m web_corpus.build",
    "corpus:load:local": "wrangler d1 execute DB --local --file corpus-build/corpus.sql",
    "corpus:load:production": "CLOUDFLARE_ENV=production wrangler d1 execute DB --remote --file corpus-build/corpus.sql",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "hono": "^4.13.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@cloudflare/vitest-plugin": "^1.4.11",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.156.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261023.1": true
  }
}
