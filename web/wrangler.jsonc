{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studybot-web",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "upload_source_maps": true,
  "triggers": { "crons": ["17 16 * * *"] },

  "vars": {
    "ENVIRONMENT": "development",
    "EMAIL_FROM": "signin@example.com",
    "EMAIL_FROM_NAME": "Clinical Recall Assistant",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "AI_GATEWAY_ACCOUNT_ID": "",
    "AI_GATEWAY_ID": "studybot-dev",
    "QUOTA_GENERATIONS_PER_MONTH": "20",
    "QUOTA_MARKS_PER_MONTH": "30"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studybot-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "RL_API", "namespace_id": "1101", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_SIGNIN_IP", "namespace_id": "1102", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_SIGNIN_EMAIL", "namespace_id": "1103", "simple": { "limit": 3, "period": 60 } }
  ],

  "env": {
    "staging": {
      "name": "studybot-web-staging",
      "workers_dev": true,
      "triggers": { "crons": ["17 16 * * *"] },
      "vars": {
        "ENVIRONMENT": "staging",
        "EMAIL_FROM": "signin@REPLACE_WITH_SENDING_DOMAIN",
        "EMAIL_FROM_NAME": "Clinical Recall Assistant (staging)",
        "TURNSTILE_SITE_KEY": "REPLACE_WITH_TURNSTILE_SITE_KEY",
        "AI_GATEWAY_ACCOUNT_ID": "REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID",
        "AI_GATEWAY_ID": "studybot-staging",
        "QUOTA_GENERATIONS_PER_MONTH": "20",
        "QUOTA_MARKS_PER_MONTH": "30"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "studybot-staging",
          "database_id": "REPLACE_WITH_STAGING_D1_ID",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        { "name": "RL_API", "namespace_id": "2101", "simple": { "limit": 120, "period": 60 } },
        { "name": "RL_SIGNIN_IP", "namespace_id": "2102", "simple": { "limit": 5, "period": 60 } },
        { "name": "RL_SIGNIN_EMAIL", "namespace_id": "2103", "simple": { "limit": 3, "period": 60 } }
      ],
      "send_email": [{ "name": "EMAIL" }]
    },
    "production": {
      "name": "studybot-web",
      "workers_dev": false,
      "triggers": { "crons": ["17 16 * * *"] },
      "vars": {
        "ENVIRONMENT": "production",
        "EMAIL_FROM": "signin@REPLACE_WITH_SENDING_DOMAIN",
        "EMAIL_FROM_NAME": "Clinical Recall Assistant",
        "TURNSTILE_SITE_KEY": "REPLACE_WITH_TURNSTILE_SITE_KEY",
        "AI_GATEWAY_ACCOUNT_ID": "REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID",
        "AI_GATEWAY_ID": "studybot-production",
        "QUOTA_GENERATIONS_PER_MONTH": "20",
        "QUOTA_MARKS_PER_MONTH": "30"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "studybot-production",
          "database_id": "REPLACE_WITH_PRODUCTION_D1_ID",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        { "name": "RL_API", "namespace_id": "3101", "simple": { "limit": 120, "period": 60 } },
        { "name": "RL_SIGNIN_IP", "namespace_id": "3102", "simple": { "limit": 5, "period": 60 } },
        { "name": "RL_SIGNIN_EMAIL", "namespace_id": "3103", "simple": { "limit": 3, "period": 60 } }
      ],
      "send_email": [{ "name": "EMAIL" }]
    }
  }
}
