{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studybot-web",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "upload_source_maps": true,
  "triggers": { "crons": ["17 16 * * *"] },

  "vars": {
    "ENVIRONMENT": "development",
    "GOOGLE_CLIENT_ID": "",
    "AI_GATEWAY_ACCOUNT_ID": "",
    "AI_GATEWAY_ID": "studybot-dev",
    "QUOTA_GENERATIONS_PER_MONTH": "20",
    "QUOTA_MARKS_PER_MONTH": "30",
    "DAILY_GENERATIONS_CAP": "200",
    "DAILY_MARKS_CAP": "1000",
    "REPORT_FLAG_THRESHOLD": "2",
    "MARKING_SCHEMA": "off"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studybot-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "RL_API", "namespace_id": "1101", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_SIGNIN_IP", "namespace_id": "1102", "simple": { "limit": 10, "period": 60 } }
  ],

  "env": {
    "staging": {
      "name": "studybot-web-staging",
      "workers_dev": true,
      "triggers": { "crons": ["17 16 * * *"] },
      "vars": {
        "ENVIRONMENT": "staging",
        "GOOGLE_CLIENT_ID": "REPLACE_WITH_GOOGLE_CLIENT_ID",
        "AI_GATEWAY_ACCOUNT_ID": "REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID",
        "AI_GATEWAY_ID": "studybot-staging",
        "QUOTA_GENERATIONS_PER_MONTH": "20",
        "QUOTA_MARKS_PER_MONTH": "30",
    "DAILY_GENERATIONS_CAP": "200",
    "DAILY_MARKS_CAP": "1000",
    "REPORT_FLAG_THRESHOLD": "2",
    "MARKING_SCHEMA": "off"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "studybot-staging",
          "database_id": "REPLACE_WITH_STAGING_D1_ID",
          "migrations_dir": "migrations"
        }
      ],
      "ai": { "binding": "AI" },
      "vectorize": [{ "binding": "VECTORIZE", "index_name": "studybot-corpus-staging" }],
      "ratelimits": [
        { "name": "RL_API", "namespace_id": "2101", "simple": { "limit": 120, "period": 60 } },
        { "name": "RL_SIGNIN_IP", "namespace_id": "2102", "simple": { "limit": 10, "period": 60 } }
      ]
    },
    "production": {
      "name": "studybot-web",
      "workers_dev": false,
      "routes": [{ "pattern": "study.paramedtools.com", "custom_domain": true }],
      "triggers": { "crons": ["17 16 * * *"] },
      "vars": {
        "ENVIRONMENT": "production",
        "GOOGLE_CLIENT_ID": "367278994932-l587ls6cmc22ve97v898cn90r0n766s2.apps.googleusercontent.com",
        "AI_GATEWAY_ACCOUNT_ID": "dbf5f9ecbc5a06cf375bb0d0f33d844a",
        "AI_GATEWAY_ID": "studybot-production",
        "QUOTA_GENERATIONS_PER_MONTH": "20",
        "QUOTA_MARKS_PER_MONTH": "30",
    "DAILY_GENERATIONS_CAP": "60",
    "DAILY_MARKS_CAP": "400",
    "REPORT_FLAG_THRESHOLD": "2",
    "MARKING_SCHEMA": "off"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "studybot-production",
          "database_id": "8ebe42cf-2ecb-41f4-9172-bd8625f87641",
          "migrations_dir": "migrations"
        }
      ],
      "ai": { "binding": "AI" },
      "vectorize": [{ "binding": "VECTORIZE", "index_name": "studybot-corpus-production" }],
      "ratelimits": [
        { "name": "RL_API", "namespace_id": "3101", "simple": { "limit": 120, "period": 60 } },
        { "name": "RL_SIGNIN_IP", "namespace_id": "3102", "simple": { "limit": 10, "period": 60 } }
      ]
    }
  }
}
